esolve()\n\nif str(repo_root) not in sys.path:\n    sys.path.insert(0, str(repo_root))\n\nfrom jax_training.models.config import Qwen3_5Config\nfrom jax_training.models.qwen3_5 import Qwen3_5ForCausalLM\n\n# 2. Tokenizer & Model\ntokenizer = AutoTokenizer.from_pretrained(\"Qwen/Qwen3.5-0.8B-Base\", trust_remote_code=True)\nconfig = Qwen3_5Config(dtype=\"bfloat16\")\nmodel = Qwen3_5ForCausalLM(config)\n\n# 3. Restore Checkpoint\nckpt_path = repo_root / \"checkpoints\" / \"jax_cpt\" / \"checkpoint-61036\" / \"state\"\ncheckpointer = ocp.StandardCheckpointer()\nrestored = checkpointer.restore(ckpt_path)\nparams = restored[\"params\"]\nembedding = params[\"model\"][\"embed_tokens\"][\"embedding\"]  # [248320, 1024]\nprint(f\"✅ Loaded checkpoint on: {jax.devices()}\")\n\n# 4. JIT-Compiled Single-Step Predictor\n@jax.jit\ndef predict_next_token_logits(params, embedding, input_ids, current_idx):\n    \"\"\"\n    Fixed-shape JIT function: No re-compilation per token.\n    input_ids shape is fixed to [1, max_total_seq_len].\n    \"\"\"\n    hidden = model.apply({\"params\": params}, input_ids)  # [1, max_seq_len, 1024]\n    last_hidden = hidden[:, current_idx, :]               # [1, 1024]\n    last_logits = jnp.matmul(last_hidden, embedding.T)    # [1, 248320]\n    return last_logits\n\n# 5. Fast Autoregressive Generator\ndef generate_code(\n    prompt: str,\n    max_new_tokens: int = 120,\n    temperature: float = 0.2,\n    repetition_penalty: float = 1.1,\n):\n    ids = tokenizer.encode(prompt, add_special_tokens=False)\n    prompt_len = len(ids)\n    max_seq_len = prompt_len + max_new_tokens\n    \n    # Pre-allocate a fixed-length buffer to prevent re-compilation\n    buffer = np.zeros(max_seq_len, dtype=np.int32)\n    buffer[:prompt_len] = ids\n    input_ids_jax = jnp.array([buffer], dtype=jnp.int32)\n    \n    print(f\"\\n--- Generating ({max_new_tokens} tokens) ---\")\n    print(prompt, end=\"\", flush=True)\n    \n    start_t = time.perf_counter()\n    new_tokens_cou