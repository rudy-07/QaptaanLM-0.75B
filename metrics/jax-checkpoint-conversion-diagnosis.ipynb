ig\",\n        \"AutoModelForCausalLM\": \"modeling_qaptaan.QaptaanForCausalLM\",\n    },\n    \"vocab_size\": 248320,\n    \"hidden_size\": 1024,\n    \"intermediate_size\": 3584,\n    \"num_hidden_layers\": 24,\n    \"num_attention_heads\": 8,\n    \"num_key_value_heads\": 2,\n    \"head_dim\": 256,\n    \"rms_norm_eps\": 1e-6,\n    \"tie_word_embeddings\": True,\n    \"max_position_embeddings\": 262144,\n    \"rope_theta\": 10000000.0,\n    \"partial_rotary_factor\": 0.25,\n    \"attn_output_gate\": True,\n    \"full_attention_interval\": 4,\n    \"linear_key_head_dim\": 128,\n    \"linear_value_head_dim\": 128,\n    \"linear_num_key_heads\": 16,\n    \"linear_num_value_heads\": 16,\n    \"linear_conv_kernel_dim\": 4,\n    \"layer_types\": [\"full_attention\" if (i + 1) % 4 == 0 else \"linear_attention\" for i in range(24)],\n    \"use_cache\": False,\n    \"torch_dtype\": \"bfloat16\",\n    \"transformers_version\": \"4.49.0\",\n}\nwith open(EXPORT_DIR / \"config.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(config_dict, f, indent=2)\n\ngen_config = {\n    \"bos_token_id\": None,\n    \"eos_token_id\": 248044,\n    \"pad_token_id\": 248044,\n    \"do_sample\": True,\n    \"temperature\": 0.6,\n    \"top_p\": 0.9,\n    \"repetition_penalty\": 1.15,\n    \"max_new_tokens\": 120,\n    \"use_cache\": False,\n    \"transformers_version\": \"4.49.0\",\n}\nwith open(EXPORT_DIR / \"generation_config.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(gen_config, f, indent=2)\n\n# ------------------------------------------------------------------------------\n# 4. Local Multi-GPU Test\n# ------------------------------------------------------------------------------\nprint(\"\\n\" + \"=\" * 80)\nprint(\"TESTING LOCAL AutoModelForCausalLM INFERENCE...\")\nprint(\"=\" * 80)\n\nmodel = AutoModelForCausalLM.from_pretrained(\n    str(EXPORT_DIR),\n    torch_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float32,\n    device_map=\"auto\",\n    trust_remote_code=True,\n)\nmodel.eval()\n\nprompt = 'def two_sum(nums: list[int], target: int) -> list[int]:\\n    \"\"\"Return indices of two numbers that add up to target.\"\"\"\\n'\ninputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\n\nwith torch.no_grad():\n    outputs = model.generate(\n        **inputs,\n        max_new_tokens=50,\n        temperature=0.6,\n        top_p=0.9,\n        repetition_penalty=1.15,\n        pad_token_id=tokenizer.eos_token_id,\n    )\n\nprint(\"\\n--- Model Output ---\")\nprint(tokenizer.decode(outputs[0], skip_special_tokens=True))\nprint(\"=\" * 80)\nprint(\"✅ Local PyTorch Validation Passed!\")\n\n# ------------------------------------------------------------------------------\n# 5. Upload to Hugging Face Hub\n# ------------------------------------------------------------------------------\nif HF_TOKEN and HF_TOKEN != \"os.environ.get("HF_TOKEN", "")\":\n    print(f\"\\nUploading to https://huggingface.co/{HF_REPO_ID}...\")\n    api = HfApi(token=HF_TOKEN)\n    api.create_repo(repo_id=HF_REPO_ID, exist_ok=True, repo_type=\"model\")\n    api.upload_folder(\n        folder_path=str(EXPORT_DIR),\n        repo_id=HF_REPO_ID,\n        repo_type=\"model\",\n        commit_message=\"Release QaptaanLM-0.75B: Clean CPT export with exact recurrence and official tokenizer\",\n        delete_patterns=[\"*\"],\n    )\n    print(f\"\\n🎉 Successfully published to: https://huggingface.co/{HF_REPO_ID}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-22T22:47:30.304892Z","iopub.execute_input":"2026-08-22T22:47:30.305402Z","iopub.status.idle":"2026-08-22T22:47:48.178288Z","shell.execute_reply.started":"2026-08-22T22:47:30.305370Z","shell.execute_reply":"2026-08-22T22:47:48.177138Z"}},"outputs":[{"name":"stdout","text":"Loading checkpoint from: /kaggle/input/datasets/sardarkhanyadav/checkpoint-train-session-2/QaptaanLM-0.75B/checkpoints/jax_cpt/checkpoint-61036/state...\n✅ Saved model.safetensors (1920.11 MB)\n",